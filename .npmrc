; ─────────────────────────────────────────────────────────────────────────────
; Pengamanan rantai pasok npm — Giricahyo Carbon
;
; Berkas ini SENGAJA ikut ter-commit. Ia tidak berisi rahasia apa pun, dan
; justru harus terbaca semua orang yang meng-clone proyek ini supaya
; perlindungannya ikut berlaku di mesin mereka, bukan cuma di satu laptop.
; ─────────────────────────────────────────────────────────────────────────────


; ignore-scripts — melarang paket menjalankan kode saat dipasang.
;
; Ini baris terpenting di berkas ini.
;
; Secara bawaan, sebuah paket boleh menaruh perintah di "scripts" bagian
; preinstall / install / postinstall. Perintah itu DIJALANKAN otomatis begitu
; paketnya masuk, dengan hak akses penuh akun yang menjalankan npm — tanpa
; kotak pasir, tanpa konfirmasi, tanpa terlihat di layar. Jadi `npm install`
; sebenarnya bukan sekadar mengunduh berkas: ia menjalankan program dari orang
; yang belum pernah kita temui.
;
; Itulah jalur yang dipakai gelombang serangan npm 2025-2026 (keluarga
; "Shai-Hulud"): pemelihara sebuah paket kena phishing, akunnya diambil alih,
; lalu versi baru diterbitkan dengan skrip yang mencuri token dan kredensial
; dari mesin siapa pun yang memasangnya. Tidak ada tinjauan kode yang harus
; ditembus — versinya sah menurut registry, karena memang diterbitkan pemilik
; akun yang benar.
;
; Kenapa aman dimatikan di proyek ini: seluruh 207 paket yang terpasang sudah
; diperiksa satu per satu, dan NOL di antaranya punya skrip preinstall,
; install, atau postinstall. Vite, React, dan Tailwind v4 mengirim binary-nya
; lewat optionalDependencies, bukan lewat skrip. Jadi mematikan ini tidak
; menghilangkan apa pun hari ini — ia menutup pintu untuk paket yang masuk
; NANTI.
;
; Skrip milik proyek sendiri tetap jalan: `npm run dev`, `npm run build`, dan
; `npm run lint` tidak terpengaruh (npm tetap menjalankan skrip yang diminta
; secara eksplisit). Yang ikut mati hanya hook pre*/post* otomatis, dan proyek
; ini memang tidak punya satu pun.
;
; Kalau suatu hari ada dependensi baru yang benar-benar butuh skripnya, build
; akan GAGAL dengan pesan jelas. Itu justru yang diinginkan: kegagalan yang
; terlihat, lalu paket itu dipasang ulang secara sadar dengan
; `npm install <paket> --ignore-scripts=false`.
ignore-scripts=true


; save-exact — versi baru dicatat persis, tanpa tanda ^.
;
; Tanpa ini, `npm install react` menulis "^19.2.0" ke package.json, yang berarti
; "19.2.0 atau versi minor/patch mana pun yang lebih baru". Hampir semua
; serangan rantai pasok datang lewat VERSI BARU dari paket yang sudah kita
; percayai, jadi rentang terbuka itu persis celahnya.
;
; Dengan save-exact, package.json mencatat "19.2.0" — kenaikan versi jadi
; keputusan sadar yang terlihat di diff, bukan sesuatu yang terjadi diam-diam
; saat orang lain menjalankan npm install.
save-exact=true


; audit-level — `npm audit` dianggap gagal mulai dari tingkat sedang.
;
; Berguna kalau nanti dipasang di CI: pipeline berhenti pada kerentanan
; moderate ke atas, bukan hanya critical.
audit-level=moderate


; fund — matikan pesan ajakan donasi setelah install.
;
; Bukan soal keamanan, tapi pesan itu memenuhi layar dan membuat peringatan
; yang sesungguhnya jadi mudah terlewat.
fund=false
