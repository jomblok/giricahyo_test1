# Alamat API.
#
# DIKOSONGKAN SENGAJA untuk pengembangan. Kalau diisi, nilainya menimpa
# penurunan otomatis di src/lib/api.js — dan memakai 127.0.0.1 di sini membuat
# pengujian lewat ponsel gagal: ponsel akan memanggil dirinya sendiri, bukan
# laptop ini.
#
# Dibiarkan kosong, alamat API mengikuti host yang sedang dibuka:
#   laptop  http://localhost:5173       -> http://localhost:8000/api
#   ponsel  http://192.168.x.x:5173     -> http://192.168.x.x:8000/api
#
# Isi HANYA saat dipasang sungguhan, ketika backend ada di domain lain:
# VITE_API_URL=https://api.domain-anda.id/api

# URL backend Laravel — ganti sesuai server saat deploy
